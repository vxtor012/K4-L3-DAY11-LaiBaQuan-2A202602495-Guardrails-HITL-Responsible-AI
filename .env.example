# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# =============================================================================
# BLUE (CP2–CP3) — CỐ ĐỊNH OpenRouter liquid/lfm-2.5-2.6b
# https://openrouter.ai/liquid/lfm-2.5-2.6b
# =============================================================================
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# RED + RED ADVANCE (CP4) — chọn MỘT provider (cùng key/model cho cả hai agent)
# Model lab mặc định (điểm bắt buộc CP4): gpt-4o-mini | gemini-3.5-flash
# Model khó (tuỳ chọn khi săn bonus):       gpt-5.6-luna | gemini-3.8-flash
# =============================================================================
# RED_TEAM_PROVIDER=openrouter
# OPENROUTER_RED_MODEL=qwen/qwen3.8-27b:free
RED_TEAM_PROVIDER=openai
# RED_TEAM_PROVIDER=gemini

# --- openai ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-5.6-luna

# --- gemini ---
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.8-flash

# --- rate limit delay (giây giữa các request, ví dụ 13 cho 5 RPM) ---
REQUEST_DELAY_SECONDS=15

